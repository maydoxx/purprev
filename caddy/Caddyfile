# shared by every address that serves the site: the public domain, plain http (:80)
# and the lan/loopback addresses (localhost, 10.10.0.12) that game servers and dev
# machines use. keep this in one place so http://localhost/asset/?id=... behaves
# exactly like https://nonerev.de/asset/?id=...
(site) {
    root * C:\Users\Administrator\Desktop\purprev\dist
    encode gzip

    header {
        ?X-Content-Type-Options nosniff
        ?Referrer-Policy strict-origin-when-cross-origin
        ?X-Frame-Options SAMEORIGIN
        ?Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    }

    @backend path /api/* /uploads/* /Game/* /game/* /Asset /asset /Asset/* /asset/* /Setting/* /Error/* /error/* /user/* /users/* /userblock/* /Friend/* /marketplace/* /ownership/* /currency/* /gametransactions/* /points/* /reservedservers/* /persistence/* /thumbs/* /Thumbs/* /moderation/* /AbuseReport/* /adimpression/* /mobileapi/* /UserCheck/* /Login/* /login/* /device/* /notifications/* /sponsoredpage/* /client-status/* /v1.0/* /v1.1/* /my/account/* /my/friendsonline /My/Places.aspx /IDE/* /ide/* /Data/* /UI/* /universes/* /developerproducts/* /setup/* /discord /games/start /pe.png /GetAllowed* /openapi /openapi/*
    handle @backend {
        reverse_proxy 127.0.0.1:3000
    }

    # the site has /groups, /groups/search and the vite bundles in /assets
    @backend_ids path_regexp ^/(groups|assets)/[0-9]+(/.*)?$
    handle @backend_ids {
        reverse_proxy 127.0.0.1:3000
    }

    @preview {
        header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|facebot|slackbot|telegrambot|whatsapp|linkedinbot|redditbot|embedly|skypeuripreview|mastodon|pleroma|misskey|cardyb|iframely|vkshare|pinterestbot)
        not path /assets/* /css/* /img/* /vendor/* *.*
    }
    handle @preview {
        rewrite * /api/embed{uri}
        reverse_proxy 127.0.0.1:3000
    }

    handle {
        @bundles path /assets/*
        header @bundles Cache-Control "public, max-age=31536000, immutable"
        @static path /css/* /img/*
        header @static Cache-Control "public, max-age=86400"
        header /index.html Cache-Control "no-cache"

        try_files {path} /index.html
        file_server
    }

    handle_errors {
        @backend_down expression {http.error.status_code} in [502, 504]
        rewrite @backend_down /{http.error.status_code}.html
        header Cache-Control "no-store"
        root * C:\caddy\pages
        file_server
    }
}

nonerev.de {
    import site
}

game.nonerev.de {
    root * C:\caddy\pages
    rewrite * /504.html
    file_server
}

:80 {
    import site
}

https://10.10.0.12 {
    tls internal
    import site
}
