(site) {
    reverse_proxy localhost:3000

    handle_errors {
        @backend_down expression {http.error.status_code} in [502, 504]
        rewrite @backend_down /{http.error.status_code}.html
        header Cache-Control "no-store"
        root * C:\caddy\pages
        file_server
    }
}

nonerev.de {
    # vite build output
    root * C:\Users\Administrator\Desktop\purprev\dist
    encode gzip

    @backend path /api/* /uploads/* /Game/* /game/* /Asset /asset /Asset/* /asset/* /Setting/* /Error/* /error/* /user/* /Friend/* /marketplace/* /ownership/* /currency/* /persistence/* /thumbs/* /Thumbs/* /moderation/* /mobileapi/* /UserCheck/* /Login/* /login/* /device/* /notifications/* /sponsoredpage/* /v1.1/* /my/account/* /my/places.aspx /My/* /IDE/* /ide/* /Data/* /UI/* /universes/* /developerproducts/* /setup/* /discord /games/start /pe.png /GetAllowed* /openapi /openapi/*
    handle @backend {
        reverse_proxy 127.0.0.1:3000
    }

    handle {
        @bundles path /assets/*
        header @bundles Cache-Control "public, max-age=31536000, immutable"
        @static path /css/* /img/*
        header @static Cache-Control "public, max-age=86400"
        header /index.html Cache-Control "no-cache"

        try_files {path} /index.html
        file_server
    }
}

