# frontend stuff
VITE_PORT=8173

# backend stuff
API_PORT=3000
# rcc refuses a base url with a port in it, so also listen on 127.0.0.1:80 for it (caddy takes the lan address)
ALSO_LISTEN=127.0.0.1:80

# if database is hosted locally, it can be localhost
# otherwise, set the host here!!!
MYSQL_HOST=10.10.0.11
MYSQL_PORT=3306
MYSQL_DATABASE=nonerev
MYSQL_USER=nonerev
MYSQL_PASSWORD=nonerev

# RCCManager credential here
RCCMANAGER_HOST=10.10.0.11
RCCMANAGER_PORT=25500
RCCMANAGER_PASSWORD=redacted

# this is needed for pulling roblox assets
ROBLOX_COOKIE=redacted

# where the launcher and client zips are (version.txt, NoneRevLauncher.exe, nonerev, <version>-NoneRevPlayer.zip)
SETUP_URL=https://rev-cdn.mrrpmeowfurry.dev/setup

# uploads and renders: local (the uploads folder) or cloudflare (an r2 bucket with a custom domain)
# rccmanager has to use the same settings
STORAGE=cloudflare
UPLOADS_DIR=uploads

# STORAGE=cloudflare: the bucket's custom domain, and an r2 api token with object read + write on it
# objects land at <R2_PREFIX>/<kind>/<id>.<ext>, leave the prefix empty when the bucket is just for this
CDN_URL=https://rev-cdn.mrrpmeowfurry.dev
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# public url the client sees in join scripts, internal one is how rcc reaches the site (lan, not cloudflare)
SITE_URL=https://nonerev.pw
SITE_INTERNAL_URL=http://10.10.0.8:3000

# signs Join.ashx and LoadPlaceInfo.ashx, the matching public key is baked into the client
JOIN_PRIVATE_KEY=keys/PrivateKey.pem
